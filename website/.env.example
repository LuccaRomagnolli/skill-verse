# Exemplo: não salve valores reais aqui nem os envie no chat.
# Configure os segredos no ambiente seguro da hospedagem Sites.
SYNCPAY_CLIENT_ID=
SYNCPAY_CLIENT_SECRET=
SYNCPAY_PUBLIC_KEY=
# Token real devolvido pela SyncPay ao criar o webhook, não um valor aleatório.
SYNCPAY_WEBHOOK_TOKEN=
RELEASE_UPLOAD_TOKEN=
PAYMENTS_ENABLED=false
SITE_ORIGIN=https://seu-site.exemplo
PACK_OBJECT_KEY=releases/engenharia-civil.zip
# Apenas para o script local de upload quando o site for privado:
SITE_PRIVATE_BYPASS_TOKEN=
